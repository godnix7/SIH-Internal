{
  "name": "yatri-shield",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "echo \"Please open 3 separate terminals and run: 1) npm run backend  2) npm run web  3) npm run start\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "backend": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn app.main:socket_app --reload",
    "web": "cd web && npm run dev",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "prepare": "husky || true"
  },
