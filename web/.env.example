# Yatri Shield Web Dashboard - Environment Variables

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Unknown Contact Details (to be filled by the client/gov)
NEXT_PUBLIC_HELP_CONTACT_EMAIL=support@yatrishield.gov.in
NEXT_PUBLIC_HELP_CONTACT_PHONE=112
NEXT_PUBLIC_TERMS_LINK=https://yatrishield.gov.in/terms
NEXT_PUBLIC_PRIVACY_LINK=https://yatrishield.gov.in/privacy

# Map Provider (Assuming OpenStreetMap for MVP, but placeholder for keys if needed)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"

# Feature Flags
NEXT_PUBLIC_ENABLE_BLOCKCHAIN_ANCHOR=true
NEXT_PUBLIC_ENABLE_KYC_MOCK=true
